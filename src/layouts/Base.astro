---
import '../styles/global.css';
import '../styles/fonts.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '네이버·구글·카카오·유튜브·인스타그램·틱톡·당근까지. 75개 광고 상품 중 지금 필요한 자리를 고르는 광고대행사.' } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <style>html,body{background:#E4E1D6}</style>
    <link rel="icon" type="image/svg+xml" href="/logo/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
