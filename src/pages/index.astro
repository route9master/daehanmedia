---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Intro from '../components/Intro.astro';
import Footer from '../components/Footer.astro';
import Plate from '../components/plates/Plate.astro';
import NextPage from '../components/NextPage.astro';
import { categories, services } from '../data/services';
import { media } from '../data/media';

// 빌드 시점 무작위 3개 추출
const allItems = Object.values(services).flat();
const shuffled = allItems.sort(() => Math.random() - 0.5);
const picked = shuffled.slice(0, 3);

const topMedia = media.slice(0, 6);
---
<Base title="대한미디어그룹 — 지면을 읽습니다">
  <Intro />
  <Header />

  <main>
    <!-- 히어로 -->
    <section class="hero" id="hero">
      <div class="hero-scan" id="hero-scan" aria-hidden="true"></div>
      <div class="hero-watermark" aria-hidden="true">
        <img src="/logo/dmg-symbol.svg" alt="" width="320" height="320" />
      </div>
      <div class="hero-inner">
        <p class="eyebrow hero-eyebrow">DAEHAN MEDIA GROUP</p>
        <h1 class="display-1 hero-title">지면을<br/>읽습니다</h1>
        <p class="hero-body">
          광고는 예산의 크기가 아니라 자리의 문제입니다.<br/>
          75개 광고 상품 중, 지금 필요한 자리를 고릅니다.
        </p>
        <div class="hero-cta">
          <a href="/services" class="cta-link cta-primary"><span class="cta-arrow">→</span>광고 도감 보기</a>
          <a href="/contact" class="cta-link cta-secondary"><span class="cta-arrow">→</span>상담 문의</a>
        </div>
        <div class="hero-index" aria-hidden="true">
          <div class="hero-index-line"></div>
          <span class="hero-index-label">INDEX</span>
          <div class="hero-index-row"><span>S</span><span>SEARCH</span><span>17</span></div>
          <div class="hero-index-row"><span>D</span><span>DISPLAY</span><span>18</span></div>
          <div class="hero-index-row"><span>V</span><span>VIDEO</span><span>8</span></div>
          <div class="hero-index-row"><span>C</span><span>COMMERCE</span><span>9</span></div>
          <div class="hero-index-row"><span>R</span><span>RETURN</span><span>12</span></div>
          <div class="hero-index-row"><span>B</span><span>BRAND</span><span>11</span></div>
        </div>
      </div>
    </section>

    <!-- 섹션 1 — 오늘의 표제어 -->
    <section class="excerpt">
      <div class="section-wrap">
        <p class="eyebrow excerpt-label">INDEX — 발췌 3/75</p>
        <div class="excerpt-grid">
          {picked.map((item) => (
            <article class="excerpt-card">
              <span class="data excerpt-code">{item.code}</span>
              <h3 class="excerpt-title">{item.title}</h3>
              <div class="excerpt-rule"></div>
              <div class="excerpt-body">
                {item.lines.map((line) => <p>{line}</p>)}
              </div>
              <div class="excerpt-plate">
                <Plate type={item.plate} />
              </div>
            </article>
          ))}
        </div>
        <div class="excerpt-footer">
          <a href="/services" class="cta-link"><span class="cta-arrow">→</span>도감 전체 보기</a>
        </div>
      </div>
    </section>

    <!-- 섹션 2 — 6개 분류 -->
    <section class="cats">
      <div class="section-wrap cats-wrap">
        <div class="cats-seal" id="cats-seal" aria-hidden="true">
          <img src="/logo/dmg-symbol.svg" alt="" width="72" height="72" />
        </div>
        <nav class="cats-list" aria-label="서비스 분류">
          {categories.map((cat) => (
            <a href={`/services/${cat.slug}`} class="cats-row">
              <span class="cats-code data">{cat.code}</span>
              <span class="cats-en" style="font-family:var(--font-rd-10);">{cat.en}</span>
              <span class="cats-ko">{cat.ko}</span>
              <span class="cats-tag">{cat.tagline}</span>
              <span class="cats-count data">{cat.count}</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <!-- 섹션 3 — 취급 지면 요약 -->
    <section class="media-sum">
      <div class="section-wrap">
        <p class="eyebrow media-sum-label">MEDIA INVENTORY</p>
        <div class="media-sum-grid">
          {topMedia.map((m) => (
            <div class="media-sum-cell">
              <span class="data media-sum-code">{m.code}</span>
              <span class="media-sum-name">{m.name}</span>
              {m.numeric ? (
                <span class="media-sum-scale-num">{m.scaleNum}<span class="media-sum-unit">{m.scaleUnit}</span></span>
              ) : (
                <span class="media-sum-scale-txt">{m.scale}</span>
              )}
            </div>
          ))}
        </div>
        <div class="media-sum-footer">
          <a href="/media" class="cta-link"><span class="cta-arrow">→</span>지면 전체 보기</a>
        </div>
      </div>
    </section>

    <!-- 섹션 4 — 일하는 방식 -->
    <section class="ways" data-header-theme="dark">
      <div class="section-wrap">
        <article class="ways-item">
          <img src="/logo/dmg-symbol-white.svg" alt="" class="ways-icon" aria-hidden="true" width="20" height="20" />
          <div>
            <h3 class="ways-title">지면부터 고릅니다</h3>
            <p class="ways-desc">예산에 맞춰 아무 자리나 채우지 않습니다. 목적에 맞는 자리를 먼저 확정합니다.</p>
          </div>
        </article>
        <div class="ways-divider"></div>
        <article class="ways-item">
          <img src="/logo/dmg-symbol-white.svg" alt="" class="ways-icon" aria-hidden="true" width="20" height="20" />
          <div>
            <h3 class="ways-title">전부 하지 않습니다</h3>
            <p class="ways-desc">75개를 다 팔지 않습니다. 지금 필요하지 않은 광고는 권하지 않습니다.</p>
          </div>
        </article>
        <div class="ways-divider"></div>
        <article class="ways-item">
          <img src="/logo/dmg-symbol-white.svg" alt="" class="ways-icon" aria-hidden="true" width="20" height="20" />
          <div>
            <h3 class="ways-title">오래 두지 않습니다</h3>
            <p class="ways-desc">반응이 없는 자리는 빠르게 바꿉니다. 소재 교체와 지면 조정은 하루 안에 움직입니다.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- 섹션 5 — 문의 유도 -->
    <section class="cta-section">
      <div class="section-wrap cta-wrap">
        <p class="cta-heading">어떤 자리가 맞을지 모르셔도 괜찮습니다.<br/>무엇을 파는지, 누구에게 팔고 싶은지부터 이야기해주세요.</p>
        <a href="/contact" class="cta-link cta-big"><span class="cta-arrow">→</span>상담 문의</a>
      </div>
    </section>
  </main>

  <NextPage href="/about" label="회사 소개" />
  <Footer />
</Base>

<style>
  /* === 공통 === */
  .section-wrap {
    max-width: 1480px;
    margin: 0 auto;
    padding: clamp(96px, 14vh, 200px) clamp(24px, 7vw, 120px);
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--ink);
    padding: 0 0 4px;
    border-bottom: 1px solid var(--ink);
    transition: border-color 180ms cubic-bezier(.2,.7,.1,1),
                transform 180ms cubic-bezier(.2,.7,.1,1);
  }

  .cta-link:hover {
    border-bottom-color: var(--seal);
    transform: translateX(4px);
  }

  .cta-arrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  /* === 히어로 === */
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: 72px;
  }

  .hero-scan {
    position: absolute;
    inset: 0;
    background: var(--paper);
    transform-origin: top center;
    z-index: 2;
    pointer-events: none;
  }

  .hero-watermark {
    position: absolute;
    right: clamp(24px, 7vw, 120px);
    bottom: clamp(32px, 6vh, 80px);
    opacity: 0.05;
    pointer-events: none;
  }

  .hero-watermark img {
    display: block;
    width: clamp(160px, 22vw, 320px);
    height: auto;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1480px;
    margin: 0 auto;
    padding: clamp(80px, 14vh, 200px) clamp(24px, 7vw, 120px);
    width: 100%;
  }

  .hero-eyebrow { color: var(--ink-mute); margin-bottom: 1.5rem; }
  .hero-title { color: var(--ink); margin-bottom: 2rem; }

  .hero-body {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 32rem;
    margin-bottom: 3rem;
  }

  .hero-cta { display: flex; gap: 48px; flex-wrap: wrap; }

  .cta-primary { color: var(--ink); }
  .cta-secondary { color: var(--ink-mute); border-bottom-color: var(--ink-mute); }

  .hero-index {
    position: absolute;
    top: calc(0.75rem + 1.5rem);
    right: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
    opacity: 0.5;
    line-height: 2.2;
  }

  .hero-index-line { width: 100%; height: 1px; background: var(--paper-edge); margin-bottom: 6px; }
  .hero-index-label { display: block; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; color: var(--ink-mute); margin-bottom: 8px; }
  .hero-index-row { display: grid; grid-template-columns: 1.2em 6.5em 2em; gap: 0.5em; }
  .hero-index-row span:last-child { text-align: right; }

  /* === 섹션 1 — 오늘의 표제어 === */
  .excerpt-label { color: var(--ink-mute); margin-bottom: clamp(32px, 4vh, 56px); }

  .excerpt-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(32px, 4vw, 64px);
  }

  .excerpt-card {
    display: flex;
    flex-direction: column;
  }

  .excerpt-code { color: var(--ink-mute); margin-bottom: 1rem; }

  .excerpt-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1.15;
    margin-bottom: 0;
  }

  .excerpt-rule {
    width: 220px;
    height: 1px;
    background: var(--paper-edge);
    margin: 1.25rem 0;
  }

  .excerpt-body p {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .excerpt-plate {
    margin-top: 1.5rem;
    max-width: 240px;
    opacity: 0.7;
  }

  .excerpt-footer { margin-top: clamp(40px, 5vh, 64px); }

  /* === 섹션 2 — 6개 분류 === */
  .cats-wrap { position: relative; }

  .cats-seal {
    position: absolute;
    top: clamp(96px, 14vh, 200px);
    right: clamp(24px, 7vw, 120px);
    opacity: 0;
    transform: scale(1.14) rotate(-2deg);
    pointer-events: none;
  }

  .cats-seal.stamped {
    opacity: 0.55;
    transform: scale(1) rotate(-2deg);
    transition: opacity 180ms cubic-bezier(.15,1.1,.3,1),
                transform 180ms cubic-bezier(.15,1.1,.3,1);
  }

  .cats-seal img {
    width: 72px;
    height: 72px;
    filter: brightness(0) saturate(100%) invert(18%) sepia(80%) saturate(2800%) hue-rotate(348deg) brightness(85%) contrast(95%);
  }

  .cats-list { display: flex; flex-direction: column; }

  .cats-row {
    display: grid;
    grid-template-columns: 60px 1fr 200px 1.4fr 80px;
    gap: 1rem;
    align-items: center;
    min-height: 120px;
    padding: 1rem 0;
    border-top: 1px solid var(--paper-edge);
    text-decoration: none;
    transition: background-color 180ms cubic-bezier(.2,.7,.1,1),
                transform 180ms cubic-bezier(.2,.7,.1,1);
  }

  .cats-row:last-child { border-bottom: 1px solid var(--paper-edge); }

  .cats-row:hover {
    background: var(--seal-wash);
    transform: translateX(6px);
  }

  .cats-row:hover .cats-en { color: var(--seal); }

  .cats-code { color: var(--ink-mute); }

  .cats-en {
    font-size: clamp(2rem, 4vw, 3.4rem);
    letter-spacing: 0.04em;
    color: var(--ink);
    transition: color 180ms cubic-bezier(.2,.7,.1,1);
  }

  .cats-ko {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .cats-tag {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--ink-mute);
    letter-spacing: -0.01em;
  }

  .cats-count {
    text-align: right;
    color: var(--brass);
    font-size: 1rem;
  }

  /* === 섹션 3 — 취급 지면 요약 === */
  .media-sum-label { color: var(--ink-mute); margin-bottom: clamp(32px, 4vh, 56px); }

  .media-sum-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    row-gap: 56px;
  }

  .media-sum-cell {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 28px;
    border-left: 1px solid var(--paper-edge);
  }

  .media-sum-code {
    color: var(--ink-mute);
    font-size: 10px;
  }

  .media-sum-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ink);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .media-sum-scale-num {
    font-family: var(--font-mono);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    color: var(--brass);
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .media-sum-unit {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--brass);
  }

  .media-sum-scale-txt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--ink);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .media-sum-footer { margin-top: clamp(40px, 5vh, 64px); }

  /* === 섹션 4 — 일하는 방식 === */
  .ways {
    background: var(--ink-deep);
    color: var(--paper);
  }

  .ways-item {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .ways-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    opacity: 0.4;
    margin-top: 6px;
  }

  .ways-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.8rem;
    letter-spacing: -0.02em;
    color: var(--paper);
    line-height: 1.25;
    margin-bottom: 0.75rem;
  }

  .ways-desc {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--paper);
    letter-spacing: -0.01em;
    max-width: 640px;
    opacity: 0.8;
  }

  .ways-divider {
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
    margin: 80px 0;
  }

  /* === 섹션 5 — 문의 유도 === */
  .cta-wrap { text-align: center; }

  .cta-heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1.65;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 2.5rem;
    word-break: keep-all;
  }

  .cta-big { font-size: 1.1rem; }

  /* === 모바일 === */
  @media (max-width: 768px) {
    .hero-index { display: none; }
    .hero { min-height: 85vh; padding-top: 100px; }
    .hero-body br { display: none; }

    .excerpt-grid { grid-template-columns: 1fr; }
    .excerpt-plate { max-width: 180px; }

    .cats-row {
      grid-template-columns: 40px 1fr 60px;
      min-height: 80px;
    }
    .cats-ko, .cats-tag { display: none; }
    .cats-en { font-size: 1.6rem; }

    .media-sum-grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 32px;
    }

    .cta-heading br { display: none; }
  }
</style>

<script>
  import Lenis from 'lenis';
  import { animate } from 'motion';

  const lenis = new Lenis({ lerp: 0.085 });
  function raf(time: number) { lenis.raf(time); requestAnimationFrame(raf); }
  requestAnimationFrame(raf);

  // 히어로 스캔
  const scan = document.getElementById('hero-scan');
  if (scan) {
    animate(scan, { scaleY: [1, 0] }, { duration: 0.9, easing: [0.2, 0.7, 0.1, 1], fill: 'forwards' });
  }

  // 분류 검인
  const catsSeal = document.getElementById('cats-seal');
  if (catsSeal) {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            (e.target as HTMLElement).classList.add('stamped');
            setTimeout(() => {
              (e.target as HTMLElement).style.filter = 'blur(0.4px)';
              setTimeout(() => { (e.target as HTMLElement).style.filter = 'none'; }, 60);
            }, 180);
            obs.unobserve(e.target);
          }
        });
      },
      { threshold: 0.5 }
    );
    obs.observe(catsSeal);
  }
</script>
