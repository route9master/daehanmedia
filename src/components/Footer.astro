---
const navItems = [
  { label: '소개', href: '/about' },
  { label: '지면', href: '/media' },
  { label: '광고', href: '/services' },
  { label: '순서', href: '/process' },
  { label: '문의', href: '/contact' },
];
---

<footer class="site-footer" data-header-theme="dark">
  <div class="footer-watermark" aria-hidden="true">
    <img src="/logo/dmg-symbol-white.svg" alt="" width="600" height="600" />
  </div>
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-left">
        <img src="/logo/dmg-lockup-vertical-white.svg" alt="대한미디어그룹" class="footer-logo" width="80" height="100" />
        <dl class="footer-dl">
          <div><dt>상호</dt><dd>대한미디어그룹</dd></div>
          <div><dt>사업자등록번호</dt><dd>707-25-02102</dd></div>
          <div><dt>통신판매업신고</dt><dd>준비중</dd></div>
          <div><dt>주소</dt><dd>서울특별시 금천구 디지털로9길 99, 스타밸리 1304-B호</dd></div>
          <div><dt>대표번호</dt><dd>준비중</dd></div>
          <div><dt>이메일</dt><dd><a href="mailto:dmg@daehanmedia.kr">dmg@daehanmedia.kr</a></dd></div>
          <div><dt>운영시간</dt><dd>평일 10:00 – 17:00</dd></div>
        </dl>
      </div>
      <div class="footer-right">
        <nav class="footer-nav" aria-label="사이트맵">
          {navItems.map(item => (
            <a href={item.href} class="footer-nav-link">{item.label}</a>
          ))}
          <a href="/privacy" class="footer-nav-link footer-nav-privacy">개인정보처리방침</a>
        </nav>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="footer-copy">&copy; 2026 대한미디어그룹</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--ink-deep);
    color: var(--paper);
    padding: clamp(64px, 10vh, 120px) 0 clamp(32px, 5vh, 48px);
  }

  .footer-watermark {
    position: absolute;
    right: -100px;
    bottom: -120px;
    opacity: 0.03;
    pointer-events: none;
  }

  .footer-watermark img {
    display: block;
    width: clamp(400px, 50vw, 600px);
    height: auto;
  }

  .footer-inner {
    position: relative;
    max-width: 1480px;
    margin: 0 auto;
    padding: 0 clamp(24px, 7vw, 120px);
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: clamp(48px, 6vw, 120px);
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .footer-logo {
    display: block;
    width: 80px;
    height: auto;
    opacity: 0.9;
  }

  .footer-dl {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-dl > div {
    display: flex;
    gap: 0.75rem;
  }

  .footer-dl dt {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--ink-mute);
    min-width: 6rem;
    flex-shrink: 0;
  }

  .footer-dl dd,
  .footer-dl dd a,
  .footer-dl dd a:any-link {
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--paper);
  }

  .footer-dl dd a {
    border-bottom: 1px solid var(--ink-mute);
    transition: border-color 220ms cubic-bezier(.2,.7,.1,1);
  }

  .footer-dl dd a:hover { border-color: var(--paper); }

  .footer-right {
    display: flex;
    align-items: flex-start;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-nav-link {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.9375rem;
    color: var(--paper);
    text-decoration: none;
    letter-spacing: -0.01em;
    opacity: 0.7;
    transition: opacity 220ms cubic-bezier(.2,.7,.1,1);
  }

  .footer-nav-link:hover { opacity: 1; }

  .footer-nav-privacy {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(228, 225, 214, 0.1);
    font-size: 0.8125rem;
    opacity: 0.5;
  }

  .footer-bottom {
    margin-top: clamp(48px, 6vh, 80px);
    padding-top: 1.5rem;
    border-top: 1px solid rgba(228, 225, 214, 0.08);
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--paper);
    opacity: 0.5;
  }

  @media (max-width: 640px) {
    .footer-top { flex-direction: column; }
    .footer-nav { flex-direction: row; flex-wrap: wrap; gap: 1rem; }
    .footer-nav-privacy { margin-top: 0; padding-top: 0; border-top: none; }
  }
</style>
