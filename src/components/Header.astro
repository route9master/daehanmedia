---
const navItems = [
  { label: '소개', href: '/about' },
  { label: '지면', href: '/media' },
  { label: '광고', href: '/services' },
  { label: '순서', href: '/process' },
  { label: '문의', href: '/contact' },
];
const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo" aria-label="대한미디어그룹 홈">
      <img src="/logo/dmg-lockup-horizontal.svg" alt="대한미디어그룹" width="120" height="30" class="logo-dark" />
      <img src="/logo/dmg-lockup-horizontal-white.svg" alt="대한미디어그룹" width="120" height="30" class="logo-light" />
    </a>
    <nav class="header-nav" aria-label="주요 메뉴">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={['header-nav-link', { active: currentPath.startsWith(item.href) }]}
        >{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition: background-color 220ms cubic-bezier(.2,.7,.1,1),
                border-color 220ms cubic-bezier(.2,.7,.1,1),
                backdrop-filter 220ms cubic-bezier(.2,.7,.1,1);
    border-bottom: 1px solid transparent;
  }

  .site-header.scrolled {
    background-color: rgba(228, 225, 214, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom-color: var(--paper-edge);
  }

  .header-inner {
    max-width: 1480px;
    margin: 0 auto;
    padding: 0 clamp(24px, 7vw, 120px);
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-logo {
    position: relative;
    display: block;
    height: 30px;
  }

  .header-logo img {
    display: block;
    height: 30px;
    width: auto;
  }

  .logo-light {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    transition: opacity 220ms cubic-bezier(.2,.7,.1,1);
  }

  .logo-dark {
    transition: opacity 220ms cubic-bezier(.2,.7,.1,1);
  }

  .site-header.dark .logo-dark { opacity: 0; }
  .site-header.dark .logo-light { opacity: 1; }

  .header-nav {
    display: flex;
    gap: 2rem;
  }

  .header-nav-link {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.9375rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.01em;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color 220ms cubic-bezier(.2,.7,.1,1),
                border-color 220ms cubic-bezier(.2,.7,.1,1);
  }

  .header-nav-link:hover {
    color: var(--seal);
  }

  .header-nav-link.active {
    color: var(--seal);
    border-bottom-color: var(--seal);
  }

  .site-header.dark .header-nav-link {
    color: var(--paper);
  }

  .site-header.dark .header-nav-link:hover {
    color: var(--paper-edge);
  }

  .site-header.dark .header-nav-link.active {
    color: var(--paper);
    border-bottom-color: var(--paper);
  }

  .site-header.dark.scrolled {
    background-color: rgba(14, 13, 11, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom-color: rgba(228, 225, 214, 0.1);
  }

  @media (max-width: 768px) {
    .header-inner {
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      padding-top: 16px;
      padding-bottom: 12px;
      gap: 10px;
    }

    .header-logo img { height: 24px; }

    .header-nav {
      gap: 1.25rem;
      flex-wrap: wrap;
    }

    .header-nav-link { font-size: 0.8125rem; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => {
      header.classList.toggle('scrolled', window.scrollY > 10);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const darkSections = document.querySelectorAll<HTMLElement>('[data-header-theme="dark"]');
    if (darkSections.length) {
      const check = () => {
        const hh = header.offsetHeight;
        let inDark = false;
        darkSections.forEach((sec) => {
          const r = sec.getBoundingClientRect();
          if (r.top < hh && r.bottom > 0) inDark = true;
        });
        header.classList.toggle('dark', inDark);
      };
      window.addEventListener('scroll', check, { passive: true });
      check();
    }
  }
</script>
